# Что не должно попадать в контекст сборки образа.
# Чем меньше контекст — тем быстрее сборка и тем меньше шансов занести в образ лишнее.

# Зависимости ставятся внутри образа (npm ci), причём под Linux:
# сборки better-sqlite3 с Windows-машины в образ попасть не должны.
node_modules
**/node_modules

# Клиент собирается внутри образа
dist
**/dist

# Секреты: настоящий .env остаётся на сервере, в образ не копируется
.env
.env.*
server/.env
server/.env.*

# База данных и её журналы WAL — только на сервере, в томе graff-data
server/data
**/*.db
**/*.db-shm
**/*.db-wal

# Служебное
.git
.github
.gitignore
.gitattributes
.claude
.vscode
.idea
.DS_Store
*.log
npm-debug.log*

# Материалы, не нужные боевому образу
design
docs
