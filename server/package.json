{
  "name": "graff-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Сервер приложения кафе GRAFF: заказы, статусы, вход по SMS, панель персонала",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "vapid": "npx web-push generate-vapid-keys",
    "seed:staff": "node --experimental-strip-types scripts/add-staff.ts",
    "test:smoke": "node --experimental-strip-types scripts/smoke-test.ts",
    "test:stream": "node --experimental-strip-types scripts/stream-test.ts",
    "test:security": "node --experimental-strip-types scripts/security-test.ts",
    "test:push": "node --experimental-strip-types scripts/push-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "better-sqlite3": "^11.8.0",
    "fastify": "^5.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.0"
  }
}
