# Настройки сервера GRAFF. Скопируйте файл и заполните значения:
#   cp server/.env.example server/.env
# Настоящий .env хранится только на сервере, в git и в образ Docker не попадает
# (см. .gitignore и .dockerignore). Кавычки вокруг значений не нужны.

# ---------- основное ----------

# Режим работы. В production сервер требует JWT_SECRET и не пишет тела запросов в журнал.
# В контейнере это значение перекрыто: docker-compose.yml жёстко задаёт NODE_ENV=production
# для сервиса app, и правка этой строки на боевой машине ни на что не влияет.
# Строка нужна для запуска сервера без Docker; для локальной разработки — development.
NODE_ENV=production

# Порт и адрес, которые слушает сервер. В Docker менять не нужно: наружу смотрит nginx.
PORT=3000
HOST=0.0.0.0

# Файл базы данных SQLite (путь относительно каталога server).
# В контейнере это /app/server/data/graff.db — том graff-data.
# ВНИМАНИЕ: в Docker путь обязан оставаться внутри data/ — томом смонтирован только
# этот каталог. База по другому пути останется внутри контейнера и исчезнет при
# первом же `docker compose up -d` с новым образом.
# 152-ФЗ, ч. 5 ст. 18: база с данными россиян должна физически находиться в России.
DB_FILE=data/graff.db

# Секрет для подписи токенов входа. ОБЯЗАТЕЛЕН в бою: без него все токены
# становятся недействительными после каждого перезапуска, а с чужим секретом
# можно подделать вход. Сгенерируйте свой (32 случайных байта):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# или, если под рукой openssl:
#   openssl rand -hex 32
# Значение никому не показывайте. При смене секрета все клиенты войдут заново.
JWT_SECRET=замените_на_случайные_64_символа

# Сколько дней живёт токен клиента: пока не истёк, вход по SMS не требуется.
TOKEN_DAYS=90

# Сколько часов живёт токен сотрудника. Смена закончилась — вход на кухне заново.
STAFF_TOKEN_HOURS=12

# Код заведения — ПЕРВЫЙ шаг входа в панель кухни: 4–8 цифр, один на кафе.
# Без него вход сотрудника вообще не отвечает, то есть подобрать личный PIN нельзя.
# В бою обязателен: сервер не запустится, если код не задан.
# Меняйте при увольнении сотрудника — он знают его наизусть.
STAFF_PANEL_CODE=замените_на_свой_код

# Сколько минут действует пропуск, выданный за код заведения.
PANEL_TICKET_MINUTES=30

# Домены, которым разрешено обращаться к API, через запятую.
# Когда приложение и API на одном домене (наша схема с nginx), можно оставить пустым.
# Пример: CORS_ORIGINS=https://graff.example.ru,https://www.graff.example.ru
CORS_ORIGINS=

# Сколько прокси стоит перед сервером. При схеме из deploy/nginx.conf — 1.
# Если приложение смотрит в интернет напрямую, поставьте 0: иначе клиент подделает
# заголовок X-Forwarded-For и обойдёт ограничения частоты запросов.
TRUST_PROXY_HOPS=1

# ---------- SMS с кодом входа ----------

# Провайдер: smsru | smsc | log. ОБЯЗАТЕЛЬНО К ЗАПОЛНЕНИЮ.
#
# smsru — sms.ru, ключ в SMS_API_ID;
# smsc  — smsc.ru, логин и пароль в SMS_LOGIN и SMS_PASSWORD;
# log   — ничего не отправляет, печатает код в журнал сервера и возвращает его
#         приложению в ответе. ТОЛЬКО для разработки, вместе с NODE_ENV=development.
#
# Пустое значение равнозначно log. При NODE_ENV=production сервер с ним НЕ ЗАПУСТИТСЯ:
# в журнале будет «SMS_PROVIDER=log недопустим при NODE_ENV=production», контейнер app
# уйдёт в цикл перезапуска, а nginx из-за depends_on не поднимется вовсе — сайт не откроется.
# Других значений сюда писать нельзя: сервер стартует, но SMS отправляться не будут,
# и вход перестанет работать молча.
SMS_PROVIDER=

# sms.ru: ключ из личного кабинета (Настройки → API).
SMS_API_ID=

# smsc.ru: логин и пароль (лучше отдельного API-пользователя, а не главного аккаунта).
SMS_LOGIN=
SMS_PASSWORD=

# Имя отправителя. Его нужно ЗАРАНЕЕ зарегистрировать у оператора связи
# (заявка через кабинет sms.ru или smsc.ru, обычно 1–3 рабочих дня, нужны документы
# на кафе). Незарегистрированное имя = сообщения не доставляются.
SMS_SENDER=GRAFF

# Текст сообщения; {code} заменяется на код. Реклама в сервисном сообщении запрещена.
SMS_TEMPLATE=Код для входа в GRAFF: {code}. Никому его не сообщайте.

# ---------- код подтверждения ----------

# Длина кода (цифр).
CODE_LENGTH=4
# Сколько минут действует код.
CODE_TTL_MINUTES=10
# Сколько попыток ввода даётся на один код (защита от перебора).
CODE_MAX_ATTEMPTS=5
# Сколько кодов можно запросить на один номер за час (защита от накрутки трат на SMS).
CODE_PER_HOUR=5

# ---------- заказы ----------

# С какого номера начинается нумерация заказов.
ORDER_START_NO=1001

# Сколько дней хранить заказы; старые удаляются автоматически.
# 152-ФЗ: данные хранятся не дольше, чем нужно для цели сбора.
# 365 дней — разумный срок для учёта и споров по чекам.
ORDER_KEEP_DAYS=365

# Обещанное время готовности по умолчанию, минут.
DEFAULT_ETA=15

# ---------- push-уведомления ----------

# Уведомления браузера о готовности заказа («Заказ принят!», «Ваш заказ №1005 готов!»).
# Работают, когда приложение свёрнуто или закрыто, — в отличие от живого потока событий.
#
# Нужна пара ключей VAPID: ими сервер подписывает сообщения для push-сервисов
# (Google, Mozilla, Apple), чтобы те принимали их именно от нас. Сгенерируйте один раз:
#   cd server && npm run vapid
# (то же самое: npx web-push generate-vapid-keys)
# Команда напечатает Public Key и Private Key — перенесите их в эти две строки.
#
# ВАЖНО: ключи менять нельзя. После смены все ранее оформленные подписки
# перестают работать, и каждому гостю придётся заново разрешать уведомления.
# Публичный ключ уезжает в браузер и секретом не является; приватный — только на сервере.
# Обе строки пустые = уведомления просто выключены, всё остальное работает как раньше.
# Подробнее — в README.md, раздел «Push-уведомления».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Контакт для push-сервиса: по нему с вами свяжутся, если с сервера пойдёт поток ошибок.
# Формат — mailto: с почтой кафе (можно и адрес сайта: https://graff.example.ru).
VAPID_SUBJECT=mailto:info@graff.example.ru

# Дополнительные адреса push-сервисов, через запятую. Оставьте пустым: сервер и так
# принимает подписки известных браузеров (Google, Mozilla, Apple, Windows), а всё
# остальное отвергает — иначе подписку можно было бы оформить на внутренний адрес
# и заставить сервер стучаться по нему при каждой смене статуса заказа.
# Заполняйте, только если поднимаете свой push-сервис; «*.» в начале разрешает поддомены.
# Пример: PUSH_ALLOWED_HOSTS=push.graff.example.ru,*.push.example.com
PUSH_ALLOWED_HOSTS=

# Уведомления приходят только тем, кто вошёл по SMS: подписка привязана к профилю.
# Гостю без входа push не отправляется — он видит статус на экране заказа.

# ---------- зал ----------

# Номера столиков по зонам, через запятую. Пусто — берутся значения по умолчанию
# (терраса 1–6, зал 7–14). Приведите к настоящей расстановке в кафе.
TABLES_TERRACE=1,2,3,4,5,6
TABLES_HALL=7,8,9,10,11,12,13,14

# Часы работы кафе в формате ЧЧ:ММ. Вне этого промежутка заказ не принимается.
# Оставьте пустыми, если приём заказов круглосуточный.
WORK_FROM=09:00
WORK_TO=23:00

# ---------- первый сотрудник ----------

# Если в базе ещё нет ни одного сотрудника, сервер заведёт его при старте
# из этих переменных. Логин и PIN — для входа в панель кухни.
# PIN хранится в базе только в виде хэша. После первого запуска значения
# можно убрать из .env, учётная запись уже создана.
# Остальных сотрудников заводите командой: npm run seed:staff -- <номер> <PIN> <имя>
# Номер удобно делать цифровым: 01, 02, 03 — его набирают на кухонном планшете.
STAFF_LOGIN=01
STAFF_PIN=замените_на_свой_PIN
STAFF_NAME=Кухня
