# Настройки сборки приложения. Скопируйте в .env и заполните под свой сервер.
# Файл .env в репозиторий не попадает.

# Адрес API сервера кафе.
#   пусто            — демонстрационный режим: заказы живут на устройстве, вход по любому коду;
#   /api             — сервер на том же домене, что и приложение (обычная боевая схема с nginx);
#   https://…/api    — сервер на другом домене (не забудьте добавить домен приложения в CORS_ORIGINS сервера).
VITE_API_URL=

# Базовый путь, если приложение лежит не в корне домена.
# Для GitHub Pages: /graff-app/   Для своего домена: не задавайте.
VITE_BASE=
